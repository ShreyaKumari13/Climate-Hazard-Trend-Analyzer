# --- MongoDB (NoSQL) ---
# MongoDB Atlas connection string. If omitted, the app uses an in-memory
# cache fallback (fine for local dev; not persistent).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=climate_hazard

# --- CORS ---
# Comma-separated allowed origins (the deployed frontend URL in production).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Caching (seconds) ---
ANALYSIS_CACHE_TTL=604800
RAW_CACHE_TTL=2592000

# --- Rate limiting ---
RATE_LIMIT=30/minute

# --- Climate logic ---
BASELINE_START=1991
BASELINE_END=2020
HEATWAVE_PERCENTILE=95
HEATWAVE_MIN_DAYS=3
